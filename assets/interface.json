{
    "interface_version": 2,
    "name": "SwEasy",
    "description": "魔灵召唤日常任务自动化工具",
    "contact": "",
    "license": "MIT",
    "welcome": "请先启动 MuMu 模拟器，并通过 ADB 连接对应实例。",
    "version": "0.1.0",
    "github": "https://github.com/BigFishWuhu/SwEasy",
    "controller": [
        {
            "name": "MuMu 模拟器",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "国服中文",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "../agent/main.py"
        ]
    },
    "task": [
        {
            "name": "启动游戏",
            "entry": "SWStartup"
        },
        {
            "name": "打开连续战斗",
            "entry": "SWOpenRepeatBattle"
        },
        {
            "name": "配置连续战斗",
            "entry": "SWOpenRepeatBattle",
            "option": [
                "战斗区域"
            ]
        },
        {
            "name": "启动/重启符文筛选网页",
            "entry": "SWRuneOpenWeb"
        },
        {
            "name": "预览仓库筛选结果",
            "entry": "SWRuneStartPreview"
        },
        {
            "name": "仓库符文自动出售",
            "entry": "SWRuneStartAutoSell",
            "pipeline_override": {
                "SWRuneDisableEquippedConfirm": {
                    "next": [
                        "SWRuneScanAutoSell"
                    ]
                }
            }
        }
    ],
    "option": {
        "战斗区域": {
            "type": "select",
            "label": "战斗区域",
            "default_case": "卡伊洛斯地下城",
            "cases": [
                {
                    "name": "卡伊洛斯地下城",
                    "option": [
                        "卡伊洛斯地下城",
                        "卡伊洛斯层数"
                    ],
                    "pipeline_override": {
                        "SWRepeatBattlePage": {
                            "next": [
                                "SWCairosOpenRoot"
                            ]
                        }
                    }
                },
                {
                    "name": "次元洞口",
                    "option": [
                        "次元区域",
                        "次元难度"
                    ],
                    "pipeline_override": {
                        "SWRepeatBattlePage": {
                            "next": [
                                "SWDimensionOpenRoot"
                            ]
                        }
                    }
                },
                {
                    "name": "二次觉醒",
                    "option": ["二觉魔灵", "次元难度", "二觉选图后操作"],
                    "pipeline_override": {
                        "SWRepeatBattlePage": {"next": ["SWDimensionOpenRoot"]},
                        "SWDimensionSelectRegion": {"next": ["SWAwakeningSelectEntry"]}
                    }
                }
            ]
        },
        "二觉选图后操作": {
            "type": "select",
            "label": "选图后操作",
            "default_case": "连续战斗",
            "cases": [
                {
                    "name": "连续战斗",
                    "pipeline_override": {
                        "SWSelectionTeamReady": {
                            "next": ["SWAwakeningBattle"],
                            "focus": {"Node.Action.Succeeded": "已选择二觉目标，准备30次连续战斗"}
                        }
                    }
                },
                {
                    "name": "仅配置队伍",
                    "pipeline_override": {"SWSelectionTeamReady": {"next": []}}
                }
            ]
        },
        "二觉魔灵": {
